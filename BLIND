local function Toggle(page, text, initial, callback)
    local button = Create("TextButton", {
        Size = UDim2.new(1, -5, 0, 38),
        BackgroundColor3 = Color3.fromRGB(32, 33, 44),
        Text = "",
        AutoButtonColor = false
    }, page)

    Round(button, 7)

    local label = Create("TextLabel", {
        Size = UDim2.new(0.7, 0, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, button)

    local state = Create("TextLabel", {
        Size = UDim2.fromOffset(55, 23),
        Position = UDim2.new(1, -65, 0.5, -11),
        BackgroundColor3 = initial and Accent or Color3.fromRGB(65, 65, 75),
        Text = initial and "ON" or "OFF",
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, button)

    Round(state, 6)

    local enabled = initial

    button.Activated:Connect(function()
        enabled = not enabled

        state.Text = enabled and "ON" or "OFF"
        state.BackgroundColor3 =
            enabled and Accent or Color3.fromRGB(65, 65, 75)

        callback(enabled)
    end)

    return button
end

-- SLIDER
local function Slider(page, text, min, max, initial, callback)
    local holder = Create("Frame", {
        Size = UDim2.new(1, -5, 0, 65),
        BackgroundColor3 = Color3.fromRGB(32, 33, 44)
    }, page)

    Round(holder, 7)

    local label = Create("TextLabel", {
        Size = UDim2.new(0.75, 0, 0, 25),
        Position = UDim2.fromOffset(10, 3),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local valueLabel = Create("TextLabel", {
        Size = UDim2.fromOffset(65, 25),
        Position = UDim2.new(1, -75, 0, 3),
        BackgroundTransparency = 1,
        Text = tostring(initial),
        TextColor3 = Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12
    }, holder)

    local bar = Create("Frame", {
        Size = UDim2.new(1, -20, 0, 7),
        Position = UDim2.fromOffset(10, 43),
        BackgroundColor3 = Color3.fromRGB(65, 65, 75)
    }, holder)

    Round(bar, 5)

    local fill = Create("Frame", {
        Size = UDim2.new((initial - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Accent
    }, bar)

    Round(fill, 5)

    local knob = Create("TextButton", {
        Size = UDim2.fromOffset(17, 17),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((initial - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Text = "",
        AutoButtonColor = false
    }, bar)

    Round(knob, 10)

    local dragging = false
    local value = initial

    local function SetValue(input)
        local percent = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        value = math.floor(min + (max - min) * percent)

        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            SetValue(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetValue(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    return holder
end

