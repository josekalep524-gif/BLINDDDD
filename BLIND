local function UpdateESP(target)
    local character = target.Character
    local data = ESP[target]

    if not character or not data then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")

    if not humanoid or not root or not head then
        return
    end

    data.Name.Visible = Config.NameESP
    data.Health.Visible = Config.HealthESP
    data.Highlight.Enabled = Config.Highlight

    local healthPercent = math.clamp(
        humanoid.Health / math.max(humanoid.MaxHealth, 1),
        0,
        1
    )

    data.Health.Size = UDim2.new(healthPercent, 0, 1, 0)

    data.Health.BackgroundColor3 =
        healthPercent > 0.5 and Color3.fromRGB(70, 220, 110)
        or healthPercent > 0.25 and Color3.fromRGB(255, 190, 60)
        or Color3.fromRGB(255, 70, 70)

    local infoText = {}

    if Config.DistanceESP then
        local myCharacter = Player.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        if myRoot then
            table.insert(infoText,
                math.floor((root.Position - myRoot.Position).Magnitude) .. " studs")
        end
    end

    if Config.WeaponESP then
        local equippedTool = character:FindFirstChildOfClass("Tool")

        if equippedTool then
            table.insert(infoText, "Weapon: " .. equippedTool.Name)
        else
            table.insert(infoText, "Weapon: None")
        end
    end

    data.Info.Text = table.concat(infoText, "\n")
    data.Info.Visible = #infoText > 0

    local screenPos, visible =
        Camera:WorldToViewportPoint(head.Position)

    data.Tracer.Visible = Config.Tracer and visible

    if Config.Tracer and visible then
        local origin = Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y
        )

        local destination = Vector2.new(screenPos.X, screenPos.Y)
        local delta = destination - origin

        data.Tracer.Position = UDim2.fromOffset(origin.X, origin.Y)
        data.Tracer.Size = UDim2.fromOffset(delta.Magnitude, 2)
        data.Tracer.Rotation = math.deg(
            math.atan2(delta.Y, delta.X)
        )
        data.Tracer.BackgroundColor3 = Accent
    end
end

